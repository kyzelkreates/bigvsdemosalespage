# ══════════════════════════════════════════════════════════════
# BIG V'S BEST ROUTES — ENVIRONMENT VARIABLES
# Copy to .env.local for local dev
# Add all of these in Vercel → Settings → Environment Variables
# NO DATABASE REQUIRED
# ══════════════════════════════════════════════════════════════

# AUTH — generate with: openssl rand -base64 32
JWT_SECRET="generate-a-random-32-char-string-here"

# VERCEL KV (add via Vercel dashboard → Storage → KV)
# These are auto-injected when you add a KV store in Vercel
KV_REST_API_URL="https://your-kv.upstash.io"
KV_REST_API_TOKEN="your-kv-token"

# TEXTBEE SMS
TEXTBEE_API_KEY="your_textbee_api_key"
TEXTBEE_DEVICE_ID="your_textbee_device_id"
ADMIN_PHONE_NUMBER="+447000000000"

# SITE
NEXT_PUBLIC_SITE_URL="https://bigvsbestroutes.com"
